# Copy this file to .env and put your own Gemini API key in it. Never commit .env.
# The same keys can instead go in .streamlit/secrets.toml (e.g. GEMINI_API_KEY = "..."), which is also gitignored and is what Streamlit Community Cloud uses.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: which Gemini model to use (used from Story 1.3).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: set to true to use built-in sample results instead of calling Gemini (used from Story 3.1).
# MOCK_MODE=false
