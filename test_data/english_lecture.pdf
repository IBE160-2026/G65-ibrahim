<< /Type /Page /Parent 2 0 R /MediaBox [0 0 792 612] /Resources << /Font << /F1 3 0 R >> >> /Contents 7 0 R >>
endobj
7 0 obj
<< /Length 600 >>
stream
BT
/F1 24 Tf
1 0 0 1 72 516 Tm
(Layers of the Earth) Tj
/F1 14 Tf
1 0 0 1 72 476 Tm
(Х The Earth has a crust, a mantle, an outer core and an inner core.) Tj
1 0 0 1 72 446 Tm
(Х The crust is thin compared with the rest of the planet.) Tj
1 0 0 1 72 416 Tm
(Х The upper mantle is solid but can flow very slowly, like warm wax.) Tj
1 0 0 1 72 386 Tm
(Х The rigid lithosphere rides on a softer layer called the asthenosphere.) Tj
1 0 0 1 72 356 Tm
(Х Heat from the deep interior keeps the mantle in slow motion.) Tj
1 0 0 1 72 326 Tm
(Х Oceanic crust is thinner and denser than continental crust.) Tj
ET
endstream
endobj
8 0 obj
<< /Type /Page /Parent 2 0 R /MediaBox [0 0 792 612] /Resources << /Font << /F1 3 0 R >> >> /Contents 9 0 R >>
endobj
